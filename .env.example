# Application
AI_CAREER_AGENT_APP_NAME=AI Career Agent
AI_CAREER_AGENT_ENVIRONMENT=local
AI_CAREER_AGENT_DEBUG=true
AI_CAREER_AGENT_LOG_LEVEL=INFO

# Database (for running the API on the host)
AI_CAREER_AGENT_DATABASE_URL=postgresql+asyncpg://ai_career_agent:change-me@localhost:5432/ai_career_agent

# Document ingestion and embeddings
AI_CAREER_AGENT_DOCUMENT_STORAGE_DIR=uploads
AI_CAREER_AGENT_MAX_UPLOAD_SIZE_BYTES=10485760
AI_CAREER_AGENT_EMBEDDING_PROVIDER=deterministic
AI_CAREER_AGENT_EMBEDDING_MODEL=text-embedding-3-small
AI_CAREER_AGENT_EMBEDDING_DIMENSIONS=256
# Required only when AI_CAREER_AGENT_EMBEDDING_PROVIDER=openai
AI_CAREER_AGENT_OPENAI_API_KEY=

# PostgreSQL container initialization
POSTGRES_DB=ai_career_agent
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=change-me
