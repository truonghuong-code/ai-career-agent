# Application
AI_CAREER_AGENT_APP_NAME=AI Career Agent
AI_CAREER_AGENT_ENVIRONMENT=local
AI_CAREER_AGENT_DEBUG=true
AI_CAREER_AGENT_LOG_LEVEL=INFO

# Database (for running the API on the host)
AI_CAREER_AGENT_DATABASE_URL=postgresql+asyncpg://ai_career_agent:change-me@localhost:5432/ai_career_agent

# PostgreSQL container initialization
POSTGRES_DB=ai_career_agent
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=change-me
