# Application
AI_CAREER_AGENT_APP_NAME=AI Career Agent
AI_CAREER_AGENT_ENVIRONMENT=local
AI_CAREER_AGENT_DEBUG=true
AI_CAREER_AGENT_LOG_LEVEL=INFO

# Database (host API/Alembic: localhost:5432; Compose API uses db:5432)
# Exported AI_CAREER_AGENT_DATABASE_URL overrides this file.
# After a test session, unset that variable to restore this local configuration.
AI_CAREER_AGENT_DATABASE_URL=postgresql+asyncpg://ai_career_agent:change-me@localhost:5432/ai_career_agent

# Document ingestion and embeddings
AI_CAREER_AGENT_DOCUMENT_STORAGE_DIR=uploads
AI_CAREER_AGENT_MAX_UPLOAD_SIZE_BYTES=10485760
AI_CAREER_AGENT_EMBEDDING_PROVIDER=deterministic
AI_CAREER_AGENT_EMBEDDING_MODEL=text-embedding-3-small
AI_CAREER_AGENT_EMBEDDING_DIMENSIONS=256
# Required when EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai
AI_CAREER_AGENT_OPENAI_API_KEY=

# PostgreSQL container initialization
POSTGRES_DB=ai_career_agent
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=change-me

# Grounded Q&A (fake is offline; does not generate semantic answers)
AI_CAREER_AGENT_LLM_PROVIDER=fake
AI_CAREER_AGENT_LLM_MODEL=gpt-4o-mini
AI_CAREER_AGENT_LLM_TIMEOUT_SECONDS=30
AI_CAREER_AGENT_LLM_MAX_OUTPUT_TOKENS=1024
AI_CAREER_AGENT_QA_MAX_CONTEXT_CHUNKS=5

# CV/JD analysis (shares LLM provider/model/timeout; independent budgets)
AI_CAREER_AGENT_ANALYSIS_MAX_CONTEXT_CHARS=40000
AI_CAREER_AGENT_ANALYSIS_MAX_OUTPUT_TOKENS=4096
